# PostgreSQL connection used by the API, Alembic migrations, and the seed command.
# The default matches the local PostgreSQL service defined in compose.yaml.
DATABASE_URL=postgresql+psycopg://compensation_hub:compensation_hub@localhost:5432/compensation_hub

# Separate database used by the automated test suite. Tests truncate its tables,
# so it must never point at the development database.
TEST_DATABASE_URL=postgresql+psycopg://compensation_hub:compensation_hub@localhost:5432/compensation_hub_test
